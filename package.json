{
  "name": "lecture-scheduler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --import ./server/register-playwright-path.js ./server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:playwright": "node ./scripts/ensure-playwright-browsers.mjs",
    "test:playwright": "node ./scripts/test-playwright.mjs",
    "test:persistent": "node ./scripts/test-persistent-context.mjs",
    "test:inflearn": "node --import ./server/register-playwright-path.js ./server/scripts/test-inflearn-one.mjs",
    "postinstall": "node ./scripts/ensure-playwright-browsers.mjs"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "playwright": "^1.57.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^5.4.11"
  }
}
